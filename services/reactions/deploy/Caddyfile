    encode zstd gzip

    handle /reactions/* {
        reverse_proxy reactions:8081 {
            header_up X-Real-IP {remote_host}
        }
    }

    # These entry documents decide which authenticated ORCID/comment UI is
    # loaded. Never leave an older bundle active after a server update.
    handle /web/iframe.html {
        header Cache-Control "no-store"
        reverse_proxy remark42:8080 {
            header_up X-Real-IP {remote_host}
        }
    }

    handle /web/embed.js {
        header Cache-Control "no-store"
        reverse_proxy remark42:8080 {
            header_up X-Real-IP {remote_host}
        }
    }

    handle /web/embed.mjs {
        header Cache-Control "no-store"
        reverse_proxy remark42:8080 {
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        reverse_proxy remark42:8080 {
            header_up X-Real-IP {remote_host}
        }
    }
