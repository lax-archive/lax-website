      "sourceText": "import LaxCore\nnamespace Lax38.Order\n/-- Every element has a successor. -/\n@[lax_statement] def HasSucc : Prop := ∀ n : Nat, ∃ m, n < m\n/-- Reflexivity, universe-polymorphic. -/\n@[lax_statement] def Refl.{u} : Prop := ∀ (α : Type u) (a : α), a = a\nend Lax38.Order\n",
      "statements": [
        {
          "id": "Lax38.Order.HasSucc",
          "levelParams": [],
          "signature": "HasSucc : Prop",
          "body": "∀ (n : Nat), Exists fun m => n < m",
          "startLine": 3,
          "endLine": 4,
          "doc": "Every element has a successor."
        },
        {
          "id": "Lax38.Order.Refl",
          "levelParams": [
