/-- EXPTIME is closed under complement. -/
axiom mem_EXPTIME_compl_iff :
  ∀ {L : Language.{0, 0}} [L.IsRelational] (P : DecisionProblem L),
    EXPTIME.Mem (DecisionProblem.compl P) ↔ EXPTIME.Mem P

end Lax480241.ExponentialComplements
