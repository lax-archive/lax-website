namespace Lax323828.GapSatisfiability

abbrev Literal := Bool × ℕ

abbrev Formula := List (List Literal)

def Satisfiable (φ : Formula) : Prop :=
  ∃ a : List Bool, ∀ c ∈ φ, ∃ l ∈ c, (a[l.2]?).getD false = l.1

