structure Literal where
  index : ℕ
  positive : Bool
  deriving DecidableEq

abbrev Assignment := ℕ → Bool

def Literal.eval (l : Literal) (ρ : Assignment) : Bool :=
  if l.positive then ρ l.index else !(ρ l.index)

