/-- Acceptance of a circuit is isomorphism-invariant. -/
axiom circuitAccepts_iso : ∀ {A B : Type} [circuit.Structure A] [circuit.Structure B],
  (A ≃[circuit] B) → (CircuitAccepts A ↔ CircuitAccepts B)

