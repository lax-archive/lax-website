/-- Being Horn and satisfiable is isomorphism-invariant. -/
axiom hornSatisfiable_iso : ∀ {A B : Type} [sat.Structure A] [sat.Structure B],
  (A ≃[sat] B) → (HornSatisfiable A ↔ HornSatisfiable B)

end Lax535992.HornSatInvariance
