{
  "name": "@lax-archive/website",
  "version": "0.1.0",
  "private": true,
  "description": "Static website generator and editorial content for the Lax Lean Archive",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
