{
  "name": "@lax-archive/website",
  "version": "0.1.0",
  "private": true,
  "description": "Static website generator and editorial content for the Lax Lean Archive",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "assets",
    "content",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/sitegen/generate.d.ts",
      "import": "./dist/sitegen/generate.js"
    },
    "./assets": {
      "types": "./dist/sitegen/assets.d.ts",
      "import": "./dist/sitegen/assets.js"
    },
    "./network": {
      "types": "./dist/sitegen/network.d.ts",
      "import": "./dist/sitegen/network.js"
    },
    "./sitegen": {
      "types": "./dist/sitegen/generate.d.ts",
      "import": "./dist/sitegen/generate.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "prepare": "npm run build",
    "test": "vitest run",
    "site:build": "tsx src/cli.ts build",
    "site:serve": "tsx src/cli.ts serve",
    "papers:fetch": "tsx src/cli.ts fetch-papers",
    "pdfjs:vendor": "node scripts/vendor-pdfjs.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "marked": "^15.0.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pdfjs-dist": "5.6.205",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
